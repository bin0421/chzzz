# docker compose가 읽는 환경변수 예시. 쓰려면 이 파일을 .env로 복사해서 고친다.
# .env가 없으면 docker-compose.yml에 적힌 기본값(아래와 같은 값)으로 뜬다.

# 전체 실행 시 브라우저로 접속할 호스트 포트 (http://localhost:3000)
APP_PORT=3000

# PostgreSQL 데이터베이스 이름과 접속 계정 (db 컨테이너 생성과 백엔드 접속에 같이 쓰인다)
DB_NAME=chzzz
DB_USERNAME=chzzz
DB_PASSWORD=chzzz

# 최대 업로드 크기 (Spring DataSize 형식: 500MB, 1GB 등)
# 백엔드 multipart 한도와 프론트 nginx의 요청 본문 한도에 같은 값이 적용된다
RECORDING_MAX_UPLOAD_SIZE=500MB

# --- 라이브 방송 (2단계) ---
# 휴대폰이 접속할 PC의 LAN IP (예: 192.168.0.5). Caddy HTTPS 인증서와 MediaMTX의 ICE 후보(영상이 오갈 주소)에 쓰인다.
# 기본값 localhost로는 PC에서만 접속할 수 있다. 휴대폰으로 확인하려면 반드시 PC의 LAN IP로 바꾼다.
PUBLIC_HOST=localhost

# 휴대폰 등 다른 기기가 접속할 HTTPS 포트 (https://PUBLIC_HOST:HTTPS_PORT, Caddy 로컬 CA 인증서)
HTTPS_PORT=8443

# MediaMTX WebRTC 미디어 포트. UDP와 TCP를 모두 쓴다 (방화벽에서 둘 다 허용해야 한다)
WEBRTC_PORT=8189

# 라이브 방송을 만든 뒤 영상이 들어오지 않으면 종료로 정리할 때까지의 대기 시간 (Spring Duration 형식: 60s, 2m 등)
LIVE_PENDING_TIMEOUT=60s

# --- 후원 결제 (4단계, 토스페이먼츠 테스트 모드) ---
# 결제위젯(주문서형)용 키 세트. 기본값은 토스 문서와 공식 샘플(github.com/tosspayments/tosspayments-sample)에 공개된
# 문서용 테스트 키라 가입 없이 쓸 수 있고 실제 돈은 나가지 않는다. 내 테스트 키를 쓰려면 개발자센터 API 키 메뉴의
# 결제위젯 연동 키(test_gck_·test_gsk_)로 바꾼다. 결제창용 API 개별 연동 키(test_ck_·test_sk_)는 이 구현에서 쓰지 않는다.
# 시크릿 키는 백엔드만 쓰고, 클라이언트 키는 백엔드가 설정 API로 프론트에 내려 준다(프론트 다시 빌드 불필요).
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 토스 API 주소. 후원 확인에는 백엔드 컨테이너가 이 주소(인터넷)에 닿아야 한다.
TOSS_API_BASE_URL=https://api.tosspayments.com

# --- 아래는 compose 전체 실행에서는 docker-compose.yml이 컨테이너 안 값으로 고정한다 ---
# 개발 실행(./gradlew bootRun)에서 백엔드가 읽는 값이며, 셸 환경변수로 넘긴다. 적힌 값이 기본값이다.
# DB_URL=jdbc:postgresql://localhost:5432/chzzz
# SERVER_PORT=8080
# RECORDING_STORAGE_DIR=./data/uploads
