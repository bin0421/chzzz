# 비밀이 아닌 설정. docker-compose.yml의 기본값과 같게 둔다.
DB_NAME=chzzz
DB_USERNAME=chzzz
DB_URL=jdbc:postgresql://db:5432/chzzz

# 업로드 폴더는 uploads PVC가 마운트된 컨테이너 안 경로로 고정한다
RECORDING_STORAGE_DIR=/app/data/uploads
RECORDING_MAX_UPLOAD_SIZE=500MB

LIVE_PENDING_TIMEOUT=60s
LIVE_PUBLISH_GRACE=30s
# 송출 대조에 쓰는 MediaMTX 제어 API. ClusterIP Service라 클러스터 안에서만 닿는다(ADR-0010)
MEDIAMTX_API_URL=http://mediamtx:9997

# 토스페이먼츠 결제위젯 클라이언트 키(브라우저에 내려가는 공개 값). 토스 문서에 공개된 테스트 키
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_API_BASE_URL=https://api.tosspayments.com
